{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "declaration": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "antd": ["./node_modules/antd"],
      "antd/*": ["./node_modules/antd/*"]
    }
  },
  "include": ["src/**/*"]
}
